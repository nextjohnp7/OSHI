# OSHI environment variables
# Copy this file to .env and adjust values for your environment.

# Application
APP_NAME=oshi
APP_ENV=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
# Development default: SQLite (local file). For production, set to a PostgreSQL URL,
# e.g. postgresql+psycopg2://user:password@localhost:5432/oshi
DATABASE_URL=sqlite:///./oshi_dev.db

# AI / LLM (configured per provider when connectors are implemented)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_key_here
